{
  "name": "pi-workbench",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Yunn Workbench：RSS 聚合 + Pi 驱动的选题发现",
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix web install",
    "install:desktop": "npm --prefix desktop install",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "desktop": "npm --prefix desktop start",
    "package:desktop": "npm --prefix desktop run package",
    "make:desktop": "npm --prefix desktop run make",
    "start": "npm --prefix server run start"
  }
}
